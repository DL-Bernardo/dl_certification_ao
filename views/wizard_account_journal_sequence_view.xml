<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Formulário do wizard -->
  <record id="view_set_journal_sequences_wizard_form" model="ir.ui.view">
    <field name="name">set.journal.sequences.wizard.form</field>
    <field name="model">set.journal.sequences.wizard</field> <!-- CORRIGIDO -->
    <field name="arch" type="xml">
      <form string="Configurar Sequências do Diário">
        <group>
          <field name="journal_id"/>
          <field name="sequence_id"/>
          <field name="refund_sequence_id"/>
        </group>
        <footer>
          <button name="set_sequences" type="object" string="Aplicar" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Ação do wizard -->
  <record id="action_set_journal_sequences_wizard" model="ir.actions.act_window">
    <field name="name">Configurar Sequências do Diário</field>
    <field name="res_model">set.journal.sequences.wizard</field> <!-- CORRIGIDO -->
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!-- Botão no formulário do diário -->
  <record id="account_journal_form_inherit_seq_btn" model="ir.ui.view">
    <field name="name">account.journal.form.seq.button</field>
    <field name="model">account.journal</field>
    <field name="inherit_id" ref="account.view_account_journal_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="before">
        <header>
          <button name="%(action_set_journal_sequences_wizard)d"
                  type="action"
                  string="Configurar Sequências"
                  class="btn-primary"
                  context="{'default_journal_id': active_id}"
                  icon="fa-cogs"/>
        </header>
      </xpath>
    </field>
  </record>
</odoo>
