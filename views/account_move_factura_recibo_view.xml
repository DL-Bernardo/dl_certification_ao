<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Ação para Facturas Normais -->
        <record id="action_move_out_invoice_normal" model="ir.actions.act_window">
            <field name="name">Facturas</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('move_type', '=', 'out_invoice'), ('journal_id.saft_inv_type', '=', 'FT')]</field>
            <field name="context" eval="{'default_move_type': 'out_invoice', 'default_journal_id': ref('dl_certification_ao.opc_journal_ft')}"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        </record>

        <!-- Novo Menu para Facturas Normais -->
        <menuitem id="menu_action_move_out_invoice_normal"
                  action="action_move_out_invoice_normal"
                  parent="account.menu_finance_receivables"
                  sequence="1"/>

        <!-- Ação para Factura - Recibo -->
        <record id="action_move_out_invoice_factura_recibo" model="ir.actions.act_window">
            <field name="name">Factura - Recibo</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('move_type', '=', 'out_invoice'), ('journal_id.saft_inv_type', '=', 'FR')]</field>
            <field name="context" eval="{'default_move_type': 'out_invoice', 'default_journal_id': ref('dl_certification_ao.opc_journal_fr')}"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        </record>

        <!-- Menu para Factura - Recibo -->
        <menuitem id="menu_action_move_out_invoice_factura_recibo"
                  action="action_move_out_invoice_factura_recibo"
                  parent="account.menu_finance_receivables"
                  sequence="2"/>


        <!-- Adicionar contexto à ação de Nota de Crédito para definir o diário padrão -->
        <record id="account.action_move_out_refund_type" model="ir.actions.act_window">
            <field name="context" eval="{'default_move_type': 'out_refund', 'default_journal_id': ref('dl_certification_ao.opc_journal_nc')}"/>
        </record>

    </data>
</odoo>