<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_modo_pagamento" model="ir.ui.view">
        <field name="name">account.move.form.modo.pagamento</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="modo_pagar_vd"
                       invisible="['|', ('journal_id.saft_inv_type', '!=', 'FR'), ('journal_id.paga_me', '=', False)]"
                       required="[('journal_id.saft_inv_type', '=', 'FR'), ('journal_id.paga_me', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>