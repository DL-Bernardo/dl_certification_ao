<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- vista do historico -->
        <record id="hist_saft_form" model="ir.ui.view">
            <field name="name">hist_saft_form</field>
            <field name="model">hist.saft</field>
            <field name="arch" type="xml">
                <form string="Histórico SAFT-PT">
                    <header>
                        <button name="do_valida" string="Validar" type="object"
                                icon="fa-check" invisible="state != 'nao_validado'"/>
                        <button name="do_submete" string="Submeter" type="object"
                                icon="fa-hand-o-down" invisible="state not in ('nao_validado', 'validado')"/>
                        <button name="do_nao_valida" string="Voltar a Não Validado" type="object"
                                icon="fa-arrow-circle-left" invisible="state not in ('submetido', 'validado')"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="data_criacao"/>
                                <field name="data_inicio"/>
                                <field name="data_fim"/>
                                <field name="user"/>
                                <field name="tipo"/>
                            </group>
                            <group>
                                <field name="empresa"/>
                                <field name="nif"/>
                                <field name="num_faturas"/>
                                <field name="valor_credito"/>
                                <field name="valor_debito"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hist_saft_tree" model="ir.ui.view">
            <field name="name">hist_saft_tree</field>
            <field name="model">hist.saft</field>
            <field name="arch" type="xml">
                <tree string="Histórico SAFT-PT" create="0">
                    <field name="data_criacao"/>
                    <field name="data_inicio"/>
                    <field name="data_fim"/>
                    <field name="empresa"/>
                    <field name="nif"/>
                    <field name="user"/>
                    <field name="tipo"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="hist_saft_search" model="ir.ui.view">
            <field name="name">hist.saft.search</field>
            <field name="model">hist.saft</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Procurar">
                    <group col="10" colspan="4">
                        <field name="data_criacao"/>
                        <field name="user"/>
                        <field name="tipo"/>
                        <field name="state"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="hist_saft_action" model="ir.actions.act_window">
            <field name="name">Histórico</field>
            <field name="res_model">hist.saft</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Histórico de exportações de Safts.
              </p>
            </field>
            <field name="context">{}</field>
        </record>

        <menuitem
                id="hist_saft_tree_menu_opc"
                action="hist_saft_action"
                parent="opc_certification_ao_v17.menu_wizard_saft_pai"
                sequence="3"/>

    </data>
</odoo>