<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_config_settings_inherit_view" model="ir.ui.view">
            <field name="name">view_account_config_settings_inherit_view</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='account']" position="inside">
                    <block title="Ajustamentos SAFT" name="saft_adjustments_setting_container">
                        <setting string="Contas de Ajustamento">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="account_adjustments_purchase" class="col-lg-4 o_light_label"/>
                                    <field name="account_adjustments_purchase" options="{'no_create_edit': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="account_adjustments_sale" class="col-lg-4 o_light_label"/>
                                    <field name="account_adjustments_sale" options="{'no_create_edit': True}"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
