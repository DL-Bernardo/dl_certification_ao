<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Grupo: Account Manager (revisado) -->
        <record id="account.group_account_manager" model="res.groups">
            <field name="name">Account Manager</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[
                (4, ref('account.group_account_user')),
                (4, ref('base.group_user'))
            ]"/>
        </record>

        <!-- Grupos de Impostos para IVA -->
        <record id="tax_group_iva_23" model="account.tax.group">
            <field name="name">IVA 23%</field>
            <field name="sequence">10</field>
        </record>

        <record id="tax_group_iva_14" model="account.tax.group">
            <field name="name">IVA 14%</field>
            <field name="sequence">11</field>
        </record>

        <record id="tax_group_iva_13" model="account.tax.group">
            <field name="name">IVA 13%</field>
            <field name="sequence">12</field>
        </record>

        <record id="tax_group_iva_6" model="account.tax.group">
            <field name="name">IVA 6%</field>
            <field name="sequence">13</field>
        </record>

        <record id="tax_group_iva_5" model="account.tax.group">
            <field name="name">IVA 5%</field>
            <field name="sequence">14</field>
        </record>

        <record id="tax_group_iva_2" model="account.tax.group">
            <field name="name">IVA 2%</field>
            <field name="sequence">15</field>
        </record>

        <!-- Grupo de Imposto Isento -->
        <record id="ao_tax_group_isento" model="account.tax.group">
            <field name="name">IVA Isento</field>
            <field name="sequence">20</field>
        </record>

        <!-- Grupo de Retenção -->
        <record id="tax_group_retencao" model="account.tax.group">
            <field name="name">Retenção na Fonte</field>
            <field name="sequence">50</field>
        </record>

    </data>
</odoo>
