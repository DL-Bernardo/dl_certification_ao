<odoo>
    <data noupdate="1">

        <function model="account.journal" name="write">
            <value model="account.journal" eval="obj().search([('name', '=', 'Faturas de Cliente')]).ids"/>
            <value eval="{
                'name': 'Faturas de Cliente',
                'por_defeito': True,
                'allow_date': False,
                'code': 'V'
            }"/>
        </function>

        <function model="account.journal" name="write">
            <value model="account.journal" eval="obj().search([('name', '=', 'Faturas de Fornecedor')]).ids"/>
            <value eval="{
                'por_defeito': True,
                'allow_date': False
            }"/>
        </function>

        <function model="account.journal" name="write">
            <value model="account.journal" eval="obj().search([('name', '=', 'Numerário')]).ids"/>
            <value eval="{
                'por_defeito': True,
                'allow_date': False,
                'saft_inv_type': 'receipt'
            }"/>
        </function>

        <function model="account.journal" name="write">
            <value model="account.journal" eval="obj().search([('name', '=', 'Banco')]).ids"/>
            <value eval="{
                'por_defeito': False,
                'allow_date': False,
                'saft_inv_type': 'receipt'
            }"/>
        </function>

        <record id="nd_journal" model="account.journal">
            <field name="name">Nota de Débito</field>
            <field name="code">ND</field>
            <field name="type">sale</field>
            <field name="refund_sequence" eval="True"/>
            <field name="saft_inv_type">ND</field>
            <field name="allow_date" eval="False"/>
        </record>

        <!-- Set SAFT type for the main Customer Invoice journal -->
        <function model="account.journal" name="write">
            <value model="account.journal" eval="obj().search([('type', '=', 'sale'), ('company_id', '=', ref('base.main_company'))], limit=1).ids"/>
            <value eval="{'saft_inv_type': 'FT'}" />
        </function>

        <!-- Journal for Invoice-Receipts -->
        <record id="journal_fr" model="account.journal">
            <field name="name">Fatura-Recibo</field>
            <field name="code">FR</field>
            <field name="type">sale</field>
            <field name="saft_inv_type">FR</field>
            <field name="refund_sequence" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Journal for Credit Notes -->
        <record id="journal_nc" model="account.journal">
            <field name="name">Nota de Crédito</field>
            <field name="code">NC</field>
            <field name="type">sale</field>
            <field name="saft_inv_type">NC</field>
            <field name="refund_sequence" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

    </data>
</odoo>